<?xml version="1.0" encoding="UTF-8" ?>
<config>
    <luceneMatchVersion>9.11.1</luceneMatchVersion>
    <lib dir="${solr.install.dir:../../../..}/dist/" regex="solr-analysis-extras-\d.*\.jar" />
    <lib dir="${solr.install.dir:../../../..}/contrib/analysis-extras/lib" regex="icu4j-\d.*\.jar" />
    <lib dir="${solr.install.dir:../../../..}/contrib/analysis-extras/lucene-libs" regex="lucene-analyzers-icu-\d.*\.jar" />

    <lib dir="${solr.install.dir}/modules/analysis-extras/lib" regex="icu4j-\d.*\.jar" />
    <lib dir="${solr.install.dir}/modules/analysis-extras/lib" regex="lucene-analysis-icu-\d.*\.jar" />
    <lib dir="${solr.install.dir}/modules/analysis-extras/lib" regex="solr-analysis-extras-\d.*\.jar" />

    <dataDir>${solr.data.dir:}</dataDir>

    <directoryFactory name="DirectoryFactory"
                      class="${solr.directoryFactory:solr.NRTCachingDirectoryFactory}" />

    <codecFactory class="solr.SchemaCodecFactory" />
    <schemaFactory class="ClassicIndexSchemaFactory" />

    <indexConfig>
        <lockType>${solr.lock.type:native}</lockType>
    </indexConfig>

    <updateHandler class="solr.DirectUpdateHandler2">
        <updateLog>
            <str name="dir">${solr.ulog.dir:}</str>
        </updateLog>
        <autoCommit>
            <maxTime>${solr.autoCommit.maxTime:60000}</maxTime>
            <openSearcher>false</openSearcher>
        </autoCommit>
        <autoSoftCommit>
            <maxTime>${solr.autoSoftCommit.maxTime:-1}</maxTime>
        </autoSoftCommit>
    </updateHandler>

    <!-- auto-generate UUIDs as document IDs when a document is indexed, if it does not already have an ID field -->
    <updateProcessor class="solr.UUIDUpdateProcessorFactory" name="uuid">
        <str name="fieldName">id</str>
    </updateProcessor>

    <!-- auto-generate a timestamp when a document is indexed -->
    <updateProcessor class="solr.TimestampUpdateProcessorFactory" name="auto-timestamp">
        <str name="fieldName">indexed</str>
    </updateProcessor>

    <updateProcessor class="solr.CloneFieldUpdateProcessorFactory" name="clone-to-text">
        <arr name="source">
            <str>additional_titles_sm</str>
            <str>alternate_names_sm</str>
            <str>alternate_terms_sm</str>
            <str>binding_notes_sm</str>
            <str>bibliographic_references_sm</str>
            <str>catalogue_numbers_sm</str>
            <str>city_address_sm</str>
            <str>city_s</str>
            <str>common_name_s</str>
            <str>contains_sigla_sm</str>
            <str>contents_notes_sm</str>
            <str>country_names_sm</str>
            <str>country_s</str>
            <str>creator_name_s</str>
            <str>date_statements_sm</str>
            <str>department_s</str>
            <str>description_summary_sm</str>
            <str>digitization_notes_sm</str>
            <str>district_s</str>
            <str>former_shelfmarks_sm</str>
            <str>former_sigla_sm</str>
            <str>general_notes_sm</str>
            <str>holding_institutions_identifiers_sm</str>
            <str>holding_institutions_places_sm</str>
            <str>holding_institutions_sm</str>
            <str>incipit_text_sm</str>
            <str>incipit_title_sm</str>
            <str>institutions_sm</str>
            <str>language_notes_sm</str>
            <str>liturgical_festivals_sm</str>
            <str>main_title_s</str>
            <str>name_s</str>
            <str>now_in_sigla_sm</str>
            <str>other_shelfmarks_sm</str>
            <str>parallel_names_sm</str>
<!--            <str>parts_held_sm</str>-->
            <str>people_names_sm</str>
            <str>performance_notes_sm</str>
            <str>plate_publisher_numbers_sm</str>
            <str>postcode_address_sm</str>
            <str>printer_name_sm</str>
            <str>provenance_sm</str>
            <str>publication_place_sm</str>
            <str>publisher_copyist_sm</str>
            <str>related_institution_sigla_sm</str>
            <str>related_institutions_sm</str>
            <str>related_people_sm</str>
<!--            <str>rism_id</str>-->
<!--            <str>rism_series_identifiers_sm</str>-->
            <str>roles_sm</str>
            <str>secondary_literature_identifiers_sm</str>
            <str>shelfmark_s</str>
            <str>siglum_s</str>
            <str>source_of_description_notes_sm</str>
            <str>source_title_s</str>
            <str>standard_title_s</str>
            <str>street_address_sm</str>
            <str>subjects_sm</str>
            <str>supplementary_material_sm</str>
            <str>term_s</str>
            <str>text_incipit_sm</str>
            <str>variant_names_sm</str>
            <str>variant_people_names_sm</str>
            <str>variant_standard_terms_sm</str>
            <str>variant_title_s</str>
            <str>watermark_notes_sm</str>
            <str>works_catalogue_sm</str>
        </arr>
        <str name="dest">text</str>
    </updateProcessor>

    <updateProcessor class="solr.CloneFieldUpdateProcessorFactory" name="clone-to-identifiers">
        <arr name="source">
            <str>catalogue_numbers_sm</str>
            <str>contains_sigla_sm</str>
            <str>former_shelfmarks_sm</str>
            <str>other_shelfmarks_sm</str>
            <str>plate_publisher_numbers_sm</str>
            <str>rism_id</str>
            <str>rism_series_identifiers_sm</str>
            <str>secondary_literature_identifiers_sm</str>
            <str>shelfmark_s</str>
        </arr>
        <str name="dest">identifiers_wstok</str>
    </updateProcessor>

    <updateProcessor class="solr.CloneFieldUpdateProcessorFactory" name="clone-to-siglum">
        <arr name="source">
            <str>contains_sigla_sm</str>
            <str>holding_institutions_sm</str>
            <str>now_in_sigla_sm</str>
            <str>related_institution_sigla_sm</str>
            <str>siglum_s</str>
        </arr>
        <str name="dest">siglum_kw</str>
    </updateProcessor>

    <updateRequestProcessorChain name="process" default="true" processor="uuid,auto-timestamp,clone-to-text,clone-to-identifiers">
        <!-- Trim leading and trailing whitespace -->
        <processor class="solr.TrimFieldUpdateProcessorFactory" />
        <processor class="solr.LogUpdateProcessorFactory" />
        <processor class="solr.RunUpdateProcessorFactory" />
    </updateRequestProcessorChain>

    <query>
        <maxBooleanClauses>${solr.max.booleanClauses:1024}</maxBooleanClauses>
        <filterCache class="solr.search.CaffeineCache"
                     async="true"
                     size="512"
                     initialSize="128"
                     autowarmCount="128" />
        <queryResultCache class="solr.search.CaffeineCache"
                          async="true"
                          size="512"
                          initialSize="128"
                          autowarmCount="128" />
        <cache name="perSegFilter"
               class="solr.search.CaffeineCache"
               size="10"
               initialSize="0"
               autowarmCount="10"
               regenerator="solr.NoOpRegenerator" />
        <enableLazyFieldLoading>true</enableLazyFieldLoading>
        <queryResultWindowSize>20</queryResultWindowSize>
        <queryResultMaxDocsCached>200</queryResultMaxDocsCached>
        <listener event="newSearcher" class="solr.QuerySenderListener">
            <arr name="queries" />
        </listener>
        <listener event="firstSearcher" class="solr.QuerySenderListener">
            <arr name="queries" />
        </listener>
        <useColdSearcher>false</useColdSearcher>
    </query>

    <requestDispatcher handleSelect="false">
        <requestParsers multipartUploadLimitInKB="2048000"
                        formdataUploadLimitInKB="2048"
                        addHttpRequestToContext="false" />
        <httpCaching never304="true" />
    </requestDispatcher>

    <!--
        A request handler that retrieves a record by ID with no default fields defined.
    -->
    <requestHandler name="/fetch" class="solr.RealTimeGetHandler">
        <lst name="defaults">
            <str name="omitHeader">true</str>
        </lst>
    </requestHandler>

    <!--
        A request handler that retrieves a record by ID that automatically transforms all
        JSON fields with the json field transformer.
    -->
    <requestHandler name="/get" class="solr.RealTimeGetHandler">
        <lst name="defaults">
            <str name="omitHeader">true</str>
            <arr name="fl">
                <str>*</str>
            </arr>
        </lst>
        <lst name="appends">
            <arr name="fl">
                <!-- specific json fields are run through the json transformer -->
                <str>subjects_json:[json]</str>
                <str>holding_institutions_json:[json]</str>
                <str>holding_titles_json:[json]</str>
                <str>material_groups_json:[json]</str>
                <str>rism_series_json:[json]</str>
                <str>creator_json:[json]</str>
                <str>relationships_json:[json]</str>
                <str>source_membership_json:[json]</str>
                <str>related_people_json:[json]</str>
                <str>related_places_json:[json]</str>
                <str>external_resources_json:[json]</str>
                <str>variant_names_json:[json]</str>
                <str>related_institutions_json:[json]</str>
                <str>liturgical_festivals_json:[json]</str>
                <str>scoring_json:[json]</str>
                <str>minimal_mss_holding_json:[json]</str>
                <str>dramatic_roles_json:[json]</str>
                <str>location_of_performance_json:[json]</str>
                <str>standard_titles_json:[json]</str>
                <str>additional_titles_json:[json]</str>
                <str>works_catalogue_json:[json]</str>
                <str>bibliographic_references_json:[json]</str>
                <str>secondary_literature_json:[json]</str>
                <str>interval_ids_json:[json]</str>
                <str>pitches_ids_json:[json]</str>
                <str>now_in_json:[json]</str>
                <str>contains_json:[json]</str>
                <str>related_sources_json:[json]</str>
                <str>external_records_jsonm:[json]</str>
                <str>addresses_json:[json]</str>
            </arr>
        </lst>
    </requestHandler>

    <requestHandler name="/select" class="solr.SearchHandler">
        <lst name="defaults">
            <str name="echoParams">explicit</str>
            <int name="rows">20</int>
            <str name="q.op">AND</str>
            <str name="sow">true</str>
            <str name="defType">edismax</str>
            <arr name="mm">
                <!-- <str>4&lt;50%</str> -->
                <str>25%</str>
            </arr>
            <str name="mm.autoRelax">true</str>
            <str name="wt">json</str>
            <arr name="fl">
                <str>*</str>
            </arr>
            <arr name="qf">
                <str>text</str>
                <str>rism_id_wstok</str>
<!--                <str>siglum_kw^5</str>-->
<!--                <str>rism_id_wstok^10</str>-->
<!--                <str>identifiers_wstok^10</str>-->
<!--                <str>identifiers_ft^5</str>-->
<!--                <str>title_composer_ft^5</str>-->
<!--                <str>publication_info_ft^2</str>-->
<!--                <str>people_names_ft^2</str>-->
<!--                <str>people_names_al^2</str>-->
<!--                <str>subjects_ft^5</str>-->
<!--                <str>notes_ft^2</str>-->
<!--                <str>institutions_ft</str>-->
<!--                <str>location_ft^5</str>-->
<!--                <str>roles_ft</str>-->
<!--                <str>source_people_names_ft</str>-->
<!--                <str>incipit_text_ft</str>-->
<!--                <str>scoring_ti</str>-->
<!--                <str>intervals_mh</str>-->
            </arr>

<!--            <int name="ps">10</int>-->
<!--            <int name="qs">10</int>-->
<!--            <arr name="pf">-->
<!--                <str>notes_ft</str>-->
<!--                <str>title_composer_ft</str>-->
<!--                <str>location_ft</str>-->
<!--            </arr>-->
<!--            <arr name="pf2">-->
<!--                <str>notes_ft</str>-->
<!--                <str>title_composer_ft</str>-->
<!--                <str>location_ft</str>-->
<!--            </arr>-->
<!--            <arr name="pf3">-->
<!--                <str>notes_ft</str>-->
<!--                <str>title_composer_ft</str>-->
<!--                <str>location_ft</str>-->
<!--            </arr>-->
            <arr name="boost">
                <!-- source count is a very crude but effective method of determining
                     more or less important people and institutions.
                -->
                <str>scale(field(total_holdings_i), 1, 100)</str>
                <str>scale(field(total_sources_i), 1, 100)</str>
            </arr>
            <arr name="bq">
                <str>is_collection_record_b:true^10</str>
            </arr>
        </lst>
        <lst name="appends">
            <arr name="fl">
                <!-- specific json fields are run through the json transformer -->
                <str>subjects_json:[json]</str>
                <str>holding_institutions_json:[json]</str>
                <str>holding_titles_json:[json]</str>
                <str>material_groups_json:[json]</str>
                <str>rism_series_json:[json]</str>
                <str>creator_json:[json]</str>
                <str>relationships_json:[json]</str>
                <str>source_membership_json:[json]</str>
                <str>related_people_json:[json]</str>
                <str>related_places_json:[json]</str>
                <str>external_resources_json:[json]</str>
                <str>variant_names_json:[json]</str>
                <str>related_institutions_json:[json]</str>
                <str>liturgical_festivals_json:[json]</str>
                <str>scoring_json:[json]</str>
                <str>minimal_mss_holding_json:[json]</str>
                <str>dramatic_roles_json:[json]</str>
                <str>location_of_performance_json:[json]</str>
                <str>standard_titles_json:[json]</str>
                <str>additional_titles_json:[json]</str>
                <str>works_catalogue_json:[json]</str>
                <str>bibliographic_references_json:[json]</str>
                <str>secondary_literature_json:[json]</str>
                <str>interval_ids_json:[json]</str>
                <str>pitches_ids_json:[json]</str>
                <str>now_in_json:[json]</str>
                <str>contains_json:[json]</str>
                <str>related_sources_json:[json]</str>
                <str>external_records_jsonm:[json]</str>
                <str>addresses_json:[json]</str>
            </arr>
        </lst>
    </requestHandler>

    <!-- A search handler that does not automatically apply the JSON field transforms,
        but otherwise matches the behaviour of the "/select" handler.
     -->
    <requestHandler name="/query" class="solr.SearchHandler">
        <lst name="defaults">
            <str name="echoParams">explicit</str>
            <int name="rows">20</int>
            <str name="q.op">AND</str>
            <str name="sow">true</str>
            <str name="defType">edismax</str>
            <arr name="mm">
                <!-- <str>4&lt;50%</str> -->
                <str>25%</str>
            </arr>
            <str name="mm.autoRelax">true</str>
            <str name="wt">json</str>
            <arr name="qf">
                <str>text</str>
                <str>rism_id_wstok</str>
