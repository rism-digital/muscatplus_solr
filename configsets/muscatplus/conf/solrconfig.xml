<!--                <str>notes_ft</str>-->
<!--                <str>title_composer_ft</str>-->
<!--                <str>location_ft</str>-->
<!--            </arr>-->
            <arr name="boost">
                <!-- source count is a very crude but effective method of determining
                     more or less important people and institutions.
                -->
                <str>scale(field(total_holdings_i), 1, 100)</str>
