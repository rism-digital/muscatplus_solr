    <!-- A very basic query handler
     -->
    <requestHandler name="/siglaQuery" class="solr.SearchHandler">
        <lst name="defaults">
            <str name="echoParams">all</str>
            <int name="rows">20</int>
            <str name="q.op">AND</str>
            <str name="defType">edismax</str>
            <str name="wt">json</str>
            <str name="sow">true</str>
            <bool name="cache">false</bool>
            <arr name="mm">
                <!-- <str>4&lt;50%</str> -->
                <str>25%</str>
            </arr>
            <arr name="qf">
                <str>siglum_kw^5</str>
                <str>identifiers_wstok</str>
<!--                <str>rism_id_wstok^10</str>-->
<!--                <str>names_ft^10</str>-->
<!--                <str>location_min_ft^5</str>-->
            </arr>
        </lst>
    </requestHandler>

    <requestHandler name="/terms" class="solr.SearchHandler" startup="lazy">
        <lst name="defaults">
            <bool name="omitHeader">true</bool>
            <bool name="terms">true</bool>
            <bool name="distrib">false</bool>
        </lst>
        <arr name="components">
            <str>terms</str>
        </arr>
    </requestHandler>

    <requestHandler name="/probe" class="solr.SearchHandler">
        <lst name="defaults">
            <str name="echoParams">explicit</str>
            <int name="rows">0</int>
            <str name="q.op">AND</str>
            <str name="sow">true</str>
            <str name="defType">edismax</str>
            <str name="wt">json</str>
            <str name="df">text</str>
            <arr name="fl">
                <str>id</str>
            </arr>
            <bool name="cache">false</bool>
        </lst>
    </requestHandler>

</config>
